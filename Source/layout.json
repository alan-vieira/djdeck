      },
      "bpm": {
        "sizePx": 11,
        "weight": "regular",
        "usage": "deck BPM + key"
      },
      "time": {
        "sizePx": 14,
        "weight": "bold",
        "usage": "deck time counters"
      },
      "pitch": {
        "sizePx": 9,
        "weight": "regular",
        "usage": "jog wheel pitch percent"
      }
