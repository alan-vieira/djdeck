  "mirroring": {
    "enabled": true,
    "parameter": "bool mirrored",
    "rule": "DeckComponent receives bool mirrored at construction; no scattered if(mirrored) in painting code — the component positions itself from the parameter.",
    "elements": {
      "padsGrid": {
        "mirrored=false": "left",
        "mirrored=true": "right",
        "label": "Beat Jump / Hot Cue pads",
        "positionRelativeToJog": {
          "mirrored=false": "left",
          "mirrored=true": "right"
        }
      },
      "jogWheel": {
        "mirrored=false": "right",
        "mirrored=true": "left",
        "label": "Jog wheel + CUE / Play",
        "positionRelativeToPads": {
          "mirrored=false": "right",
          "mirrored=true": "left"
        }
      },
      "cuePlayButtons": {
        "mirrored=false": "left",
        "mirrored=true": "right",
        "label": "CUE and play/pause",
        "positionRelativeToJog": {
          "mirrored=false": "left side",
          "mirrored=true": "right side"
        }
      },
      "eqLabels": {
        "mirrored=false": "right",
        "mirrored=true": "left",
        "label": "EQ knob labels"
      }
    }
